// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  BANK
  CASH
  RECEIVABLE
  CREDIT
}

enum CategoryType {
  EXPENSE
  INCOME
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  LEND
  REPAYMENT
  ADJUSTMENT
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  authProvider   String
  providerUserId String
  email          String   @unique
  name           String?
  avatarUrl      String?
  countryCode    String?  @db.VarChar(2)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  accounts     Account[]
  categories   Category[]
  transactions Transaction[]
  receipts     Receipt[]

  @@unique([authProvider, providerUserId])
  @@map("users")
}

model Account {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @db.Uuid
  name           String
  type           AccountType
  currency       String      @default("INR")
  openingBalance Decimal     @default(0) @db.Decimal(19, 4)
  isActive       Boolean     @default(true)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  user    User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries TransactionEntry[]

  @@index([userId])
  @@index([userId, type])
  @@map("accounts")
}

model Category {
  id        String       @id @default(uuid()) @db.Uuid
  userId    String?      @db.Uuid
  name      String
  type      CategoryType
  icon      String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([userId, name, type])
  @@index([userId])
  @@index([userId, type])
  @@map("categories")
}

model Transaction {
  id              String          @id @default(uuid()) @db.Uuid
  userId          String          @db.Uuid
  categoryId      String?         @db.Uuid
  transactionDate DateTime        @db.Date
  description     String
  type            TransactionType
  reference       String?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  entries  TransactionEntry[]
  receipts Receipt[]

  @@index([userId, transactionDate])
  @@index([userId, type])
  @@index([userId, categoryId])
  @@map("transactions")
}

model Holiday {
  id          String   @id @default(uuid()) @db.Uuid
  holidayDate DateTime @db.Date
  name        String
  countryCode String   @db.VarChar(2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([countryCode, holidayDate, name])
  @@index([countryCode, holidayDate])
  @@map("holidays")
}

model HolidayYearSync {
  countryCode String   @db.VarChar(2)
  year        Int
  syncedAt    DateTime @default(now())

  @@id([countryCode, year])
  @@map("holiday_year_syncs")
}

model TransactionEntry {
  id            String   @id @default(uuid()) @db.Uuid
  transactionId String   @db.Uuid
  accountId     String   @db.Uuid
  amount        Decimal  @db.Decimal(19, 4)
  createdAt     DateTime @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     Account     @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([accountId])
  @@map("transaction_entries")
}

model Receipt {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @db.Uuid
  transactionId    String   @db.Uuid
  storageKey       String
  originalFilename String
  mimeType         String
  fileSize         Int
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([transactionId])
  @@map("receipts")
}
