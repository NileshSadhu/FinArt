# ══════════════════════════════════════════════════════════════════════════════
# FinArt — Environment Variables Template
# ══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values. NEVER commit .env to git.
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql://postgres:root@localhost:5432/karchaChitta

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000

# ── DB Connection Pool (optional — these are the defaults) ───────────────────
DB_POOL_MAX=10
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECT_TIMEOUT_MS=5000

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web application
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The redirect URI must EXACTLY match what is registered in Google Cloud Console
# Dev:  http://localhost:8000/api/v1/auth/google/callback
# Prod: https://yourdomain.com/api/v1/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:8000/api/v1/auth/google/callback

# ── Session ───────────────────────────────────────────────────────────────────
# Must be a long, random secret string. Rotate this if compromised.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── CORS ──────────────────────────────────────────────────────────────────────
# The URL of your frontend app (no trailing slash)
CLIENT_ORIGIN=http://localhost:5173

# ── Runtime ───────────────────────────────────────────────────────────────────
# Set to "production" in prod. Affects cookie security and HTTPS enforcement.
NODE_ENV=development

# ── Calendarific API ──────────────────────────────────────────────────────
# Get a free API key at: https://calendarific.com/signup
# Used to fetch public holidays by country (cached in DB after first fetch)
CALENDARIFIC_API_KEY=
